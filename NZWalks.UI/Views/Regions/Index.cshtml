@model IEnumerable<NZWalks.UI.Models.DTO.RegionDTO>
@{
}
<h1 class="mt-3">Region</h1>
<div class="d-flex justify-content-end">
    <a class="btn btn-secondary" asp-controller="Regions" asp-action="Add">Add Region</a>
</div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Code</th>
            <th>Name</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var region in Model)
        {
            <tr> 
                <td>@region.Id</td>
                <td>@region.Code</td>
                <td>@region.Name</td>
                <td> 
                    <a class="btn btn-light" asp-controller="Regions" asp-route-id="@region.Id" asp-action="Edit">Edit</a>
                </td>

            </tr>
        }
    </tbody>

</table>